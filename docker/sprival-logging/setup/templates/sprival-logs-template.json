{
  "index_patterns": ["sprival-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.lifecycle.name": null,
      "index.lifecycle.rollover_alias": null
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "timestamp": {
          "type": "date"
        },
        "level": {
          "type": "keyword"
        },
        "message": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "logger": {
          "type": "keyword"
        },
        "logger_name": {
          "type": "keyword"
        },
        "thread": {
          "type": "keyword"
        },
        "throwable": {
          "type": "text"
        },
        "has_exception": {
          "type": "boolean"
        },
        "log_source": {
          "type": "keyword"
        },
        "index_prefix": {
          "type": "keyword"
        },
        "@metadata": {
          "type": "object",
          "enabled": false
        }
      },
      "dynamic_templates": [
        {
          "mdc_fields": {
            "match": "mdc_*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "custom_fields": {
            "match": "custom_*",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        },
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            }
          }
        }
      ]
    }
  },
  "priority": 200,
  "composed_of": [],
  "version": 1,
  "_meta": {
    "description": "Template for sprival application logs from Kafka"
  }
}

