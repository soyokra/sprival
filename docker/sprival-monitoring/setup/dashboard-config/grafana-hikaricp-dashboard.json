{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "datasource",
                    "uid": "grafana"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 100,
            "panels": [],
            "title": "健康状态总览",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "连接池整体健康度：(活动连接数 + 空闲连接数) / 最大连接数。\n- 绿色 (<70%)：连接池健康\n- 黄色 (70-90%)：连接池压力较大\n- 红色 (>90%)：连接池接近饱和，需要关注",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 70
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 0,
                "y": 1
            },
            "id": 101,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "((hikaricp_connections_active{instance=~\"$instance\", pool=~\"$pool\"} + hikaricp_connections_idle{instance=~\"$instance\", pool=~\"$pool\"}) / clamp_min(hikaricp_connections_max{instance=~\"$instance\", pool=~\"$pool\"}, 1)) * 100",
                    "refId": "A"
                }
            ],
            "title": "连接池健康度",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "当前正在使用的活动连接数。趋势线帮助观察连接使用模式。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 5,
                "y": 1
            },
            "id": 102,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "hikaricp_connections_active{instance=~\"$instance\", pool=~\"$pool\"}",
                    "refId": "A"
                }
            ],
            "title": "当前活动连接数",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "等待获取连接的线程数。\n- 绿色 (0)：无等待\n- 红色 (>0)：有线程在等待，连接池可能不足",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 10,
                "y": 1
            },
            "id": 103,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "hikaricp_connections_pending{instance=~\"$instance\", pool=~\"$pool\"}",
                    "refId": "A"
                }
            ],
            "title": "等待线程数",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "最近 5 分钟内连接获取超时的次数。\n- 绿色 (0)：无超时\n- 红色 (>0)：发生超时，需要排查原因",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 14,
                "y": 1
            },
            "id": 104,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "increase(hikaricp_connections_timeout_total{instance=~\"$instance\", pool=~\"$pool\"}[5m])",
                    "refId": "A"
                }
            ],
            "title": "5分钟超时次数",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "平均连接获取延迟（5分钟窗口）。\n- 绿色 (<10ms)：性能良好\n- 黄色 (10-50ms)：性能一般\n- 红色 (>50ms)：性能较差，需要优化",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 50
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 19,
                "y": 1
            },
            "id": 105,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "(rate(hikaricp_connections_acquire_seconds_sum{instance=~\"$instance\", pool=~\"$pool\"}[5m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count{instance=~\"$instance\", pool=~\"$pool\"}[5m]), 0.001)) * 1000",
                    "refId": "A"
                }
            ],
            "title": "平均获取延迟",
            "type": "stat"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 6
            },
            "id": 24,
            "panels": [],
            "title": "连接池基础配置",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "连接池配置的最大连接数，通常由 spring.datasource.hikari.maximum-pool-size 配置。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 7
            },
            "id": 2,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "hikaricp_connections_max{instance=~\"$instance\", pool=~\"$pool\"}",
                    "refId": "A"
                }
            ],
            "title": "最大连接数 (max)",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "连接池配置的最小空闲连接数，通常由 spring.datasource.hikari.minimum-idle 配置。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 8,
                "y": 7
            },
            "id": 4,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "hikaricp_connections_min{instance=~\"$instance\", pool=~\"$pool\"}",
                    "refId": "A"
                }
            ],
            "title": "最小空闲连接数 (min)",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "活动连接数占最大连接数的百分比。\n- 绿色 (<80%)：资源充足\n- 黄色 (80-90%)：接近上限\n- 红色 (>90%)：资源紧张",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 80
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 16,
                "y": 7
            },
            "id": 6,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "(hikaricp_connections_active{instance=~\"$instance\", pool=~\"$pool\"} / clamp_min(hikaricp_connections_max{instance=~\"$instance\", pool=~\"$pool\"}, 1)) * 100",
                    "refId": "A"
                }
            ],
            "title": "连接利用率 (%)",
            "type": "stat"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 11
            },
            "id": 26,
            "panels": [],
            "title": "连接状态监控",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "连接池中的活动连接、空闲连接和总连接数趋势。总连接数应该保持在最大连接数以下。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "最大连接数"
                        },
                        "properties": [
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "dash": [
                                        10,
                                        10
                                    ],
                                    "fill": "dash"
                                }
                            },
                            {
                                "id": "custom.fillOpacity",
                                "value": 0
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            },
            "id": 8,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "hikaricp_connections_active{instance=~\"$instance\", pool=~\"$pool\"}",
                    "legendFormat": "活动连接数",
                    "refId": "A"
                },
                {
                    "expr": "hikaricp_connections_idle{instance=~\"$instance\", pool=~\"$pool\"}",
                    "legendFormat": "空闲连接数",
                    "refId": "B"
                },
                {
                    "expr": "hikaricp_connections_active{instance=~\"$instance\", pool=~\"$pool\"} + hikaricp_connections_idle{instance=~\"$instance\", pool=~\"$pool\"}",
                    "legendFormat": "总连接数",
                    "refId": "C"
                },
                {
                    "expr": "hikaricp_connections_max{instance=~\"$instance\", pool=~\"$pool\"}",
                    "legendFormat": "最大连接数",
                    "refId": "D"
                }
            ],
            "title": "活动/空闲连接趋势",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "等待获取连接的线程数和连接超时次数。等待线程数持续大于 0 说明连接池不足，超时次数增加说明需要调整超时配置或优化数据库性能。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*超时.*"
                        },
                        "properties": [
                            {
                                "id": "custom.axisPlacement",
                                "value": "right"
                            },
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            },
            "id": 10,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "hikaricp_connections_pending{instance=~\"$instance\", pool=~\"$pool\"}",
                    "legendFormat": "等待连接的线程数",
                    "refId": "A"
                },
                {
                    "expr": "increase(hikaricp_connections_timeout_total{instance=~\"$instance\", pool=~\"$pool\"}[5m])",
                    "legendFormat": "连接超时数 (5m增量)",
                    "refId": "B"
                }
            ],
            "title": "连接等待与超时",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 20
            },
            "id": 30,
            "panels": [],
            "title": "连接池吞吐量",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "连接获取速率和连接创建速率。获取速率高说明应用并发访问数据库频繁，创建速率高说明连接复用率低或连接池不足。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "reqps"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 21
            },
            "id": 31,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "rate(hikaricp_connections_acquire_seconds_count{instance=~\"$instance\", pool=~\"$pool\"}[1m])",
                    "legendFormat": "连接获取速率 (次/秒)",
                    "refId": "A"
                },
                {
                    "expr": "rate(hikaricp_connections_creation_seconds_count{instance=~\"$instance\", pool=~\"$pool\"}[1m])",
                    "legendFormat": "连接创建速率 (次/秒)",
                    "refId": "B"
                }
            ],
            "title": "连接获取与创建速率",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 29
            },
            "id": 28,
            "panels": [],
            "title": "性能指标监控",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "连接获取、创建和使用的延迟指标。\n- 获取延迟：从连接池获取连接的时间\n- 创建延迟：创建新连接的时间\n- 使用时长：业务代码持有连接的时间\n\n显示平均值和最大值，帮助识别性能瓶颈。参考文档：https://github.com/brettwooldridge/HikariCP",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*最大.*"
                        },
                        "properties": [
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "dash": [
                                        5,
                                        10
                                    ],
                                    "fill": "dash"
                                }
                            },
                            {
                                "id": "custom.fillOpacity",
                                "value": 0
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 30
            },
            "id": 14,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "(rate(hikaricp_connections_acquire_seconds_sum{instance=~\"$instance\", pool=~\"$pool\"}[5m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count{instance=~\"$instance\", pool=~\"$pool\"}[5m]), 0.001)) * 1000",
                    "legendFormat": "获取连接 - 平均延迟",
                    "refId": "A"
                },
                {
                    "expr": "hikaricp_connections_acquire_seconds_max{instance=~\"$instance\", pool=~\"$pool\"} * 1000",
                    "legendFormat": "获取连接 - 最大延迟",
                    "refId": "B"
                },
                {
                    "expr": "(rate(hikaricp_connections_creation_seconds_sum{instance=~\"$instance\", pool=~\"$pool\"}[5m]) / clamp_min(rate(hikaricp_connections_creation_seconds_count{instance=~\"$instance\", pool=~\"$pool\"}[5m]), 0.001)) * 1000",
                    "legendFormat": "创建连接 - 平均延迟",
                    "refId": "C"
                },
                {
                    "expr": "hikaricp_connections_creation_seconds_max{instance=~\"$instance\", pool=~\"$pool\"} * 1000",
                    "legendFormat": "创建连接 - 最大延迟",
                    "refId": "D"
                },
                {
                    "expr": "(rate(hikaricp_connections_usage_seconds_sum{instance=~\"$instance\", pool=~\"$pool\"}[5m]) / clamp_min(rate(hikaricp_connections_usage_seconds_count{instance=~\"$instance\", pool=~\"$pool\"}[5m]), 0.001)) * 1000",
                    "legendFormat": "连接使用 - 平均时长",
                    "refId": "E"
                },
                {
                    "expr": "hikaricp_connections_usage_seconds_max{instance=~\"$instance\", pool=~\"$pool\"} * 1000",
                    "legendFormat": "连接使用 - 最大时长",
                    "refId": "F"
                }
            ],
            "title": "连接延迟与使用时长（平均/最大）",
            "type": "timeseries"
        }
    ],
