                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 7
            },
            "id": 202,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "rabbitmq_channels{instance=~\"$instance\", job=~\"$job\"}",
                    "legendFormat": "通道数 (channels)",
                    "refId": "A"
                }
            ],
            "title": "通道数趋势",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 15
            },
            "id": 300,
            "panels": [],
            "title": "消息发布监控",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "消息发布速率统计，包括总发布量、确认量、失败量和未路由量。用于监控发布流量和问题诊断。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "msg/s"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*失败.*"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*未路由.*"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "orange",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            },
            "id": 301,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "rate(rabbitmq_published_total{instance=~\"$instance\", job=~\"$job\"}[1m])",
                    "legendFormat": "总发布速率 (msg/s)",
                    "refId": "A"
                },
                {
                    "expr": "rate(rabbitmq_acknowledged_published_total{instance=~\"$instance\", job=~\"$job\"}[1m])",
                    "legendFormat": "确认发布速率 (msg/s)",
                    "refId": "B"
                },
                {
                    "expr": "rate(rabbitmq_failed_to_publish_total{instance=~\"$instance\", job=~\"$job\"}[1m])",
                    "legendFormat": "失败发布速率 (msg/s)",
                    "refId": "C"
                },
                {
                    "expr": "rate(rabbitmq_unrouted_published_total{instance=~\"$instance\", job=~\"$job\"}[1m])",
                    "legendFormat": "未路由速率 (msg/s)",
                    "refId": "D"
                }
            ],
            "title": "发布速率统计",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "消息发布确认率趋势。发布确认率应保持在 99% 以上，未确认率应接近 0。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*未确认.*"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "orange",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 16
            },
            "id": 302,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "min"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "(rate(rabbitmq_acknowledged_published_total{instance=~\"$instance\", job=~\"$job\"}[5m]) / clamp_min(rate(rabbitmq_published_total{instance=~\"$instance\", job=~\"$job\"}[5m]), 0.001)) * 100",
                    "legendFormat": "发布确认率 (%)",
                    "refId": "A"
                },
                {
                    "expr": "(rate(rabbitmq_not_acknowledged_published_total{instance=~\"$instance\", job=~\"$job\"}[5m]) / clamp_min(rate(rabbitmq_published_total{instance=~\"$instance\", job=~\"$job\"}[5m]), 0.001)) * 100",
                    "legendFormat": "未确认率 (%)",
                    "refId": "B"
                }
            ],
            "title": "发布确认率趋势",
            "type": "timeseries"
        },
