            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 7
            },
            "id": 201,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "rabbitmq_connections{instance=~\"$instance\", job=~\"$job\"}",
                    "legendFormat": "连接数 (connections)",
                    "refId": "A"
                }
            ],
            "title": "连接数趋势",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "RabbitMQ 通道数趋势。通道数过高可能影响性能，建议优化通道复用。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
