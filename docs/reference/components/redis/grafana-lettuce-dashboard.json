{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "datasource",
                    "uid": "grafana"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 100,
            "panels": [],
            "title": "Redis 客户端健康状态总览",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "Redis 命令执行吞吐量（每秒完成的命令数）。高吞吐量表示 Redis 使用频繁。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ops"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 0,
                "y": 1
            },
            "id": 101,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "sum(rate(lettuce_command_completion_seconds_count{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[1m]))",
                    "refId": "A"
                }
            ],
            "title": "命令吞吐量",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "Redis 命令平均完成延迟。\n- 绿色 (<10ms)：性能优秀\n- 黄色 (10-50ms)：性能一般\n- 红色 (>50ms)：性能较差，需要优化",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 50
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 5,
                "y": 1
            },
            "id": 102,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "(sum(rate(lettuce_command_completion_seconds_sum{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) / clamp_min(sum(rate(lettuce_command_completion_seconds_count{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])), 0.001)) * 1000",
                    "refId": "A"
                }
            ],
            "title": "平均命令延迟",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "最大 Redis 命令完成延迟。用于识别性能尖刺和异常慢查询。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 10,
                "y": 1
            },
            "id": 103,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "max(lettuce_command_completion_seconds_max{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}) * 1000",
                    "refId": "A"
                }
            ],
            "title": "最大命令延迟",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "Spring Cache 缓存命中率。\n- 绿色 (>80%)：命中率优秀\n- 黄色 (60-80%)：命中率一般\n- 红色 (<60%)：命中率较低，需要优化缓存策略",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 60
                            },
                            {
                                "color": "green",
                                "value": 80
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 15,
                "y": 1
            },
            "id": 104,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "(sum(rate(cache_gets_total{instance=~\"$instance\", job=~\"$job\", cache_name=~\"$cache_name\", result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_gets_total{instance=~\"$instance\", job=~\"$job\", cache_name=~\"$cache_name\"}[5m])), 0.001)) * 100",
                    "refId": "A"
                }
            ],
            "title": "缓存命中率",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "缓存操作速率：包括 Gets、Puts 和 Removals 的总和。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ops"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 19,
                "y": 1
            },
            "id": 105,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "sum(rate(cache_gets_total{instance=~\"$instance\", job=~\"$job\", cache_name=~\"$cache_name\"}[1m])) + sum(rate(cache_puts_total{instance=~\"$instance\", job=~\"$job\", cache_name=~\"$cache_name\"}[1m])) + sum(rate(cache_removals_total{instance=~\"$instance\", job=~\"$job\", cache_name=~\"$cache_name\"}[1m]))",
                    "refId": "A"
                }
            ],
            "title": "缓存操作速率",
            "type": "stat"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 6
            },
            "id": 200,
            "panels": [],
            "title": "命令延迟监控",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "Redis 命令完成延迟分布（P50/P95/P99 和最大值）。用于分析命令执行性能和识别慢查询。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*最大.*"
                        },
                        "properties": [
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "dash": [5, 10],
                                    "fill": "dash"
                                }
                            },
                            {
                                "id": "custom.fillOpacity",
                                "value": 0
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 7
            },
            "id": 201,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(lettuce_command_completion_seconds_bucket{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (le, command)) * 1000",
                    "legendFormat": "P50 - {{command}}",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(lettuce_command_completion_seconds_bucket{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (le, command)) * 1000",
                    "legendFormat": "P95 - {{command}}",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(lettuce_command_completion_seconds_bucket{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (le, command)) * 1000",
                    "legendFormat": "P99 - {{command}}",
                    "refId": "C"
                },
                {
                    "expr": "lettuce_command_completion_seconds_max{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"} * 1000",
                    "legendFormat": "最大值 - {{command}}",
                    "refId": "D"
                }
            ],
            "title": "命令完成延迟分布",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "Redis 命令首次响应延迟分布（P50/P95/P99 和最大值）。首次响应延迟主要反映网络延迟和 Redis 处理延迟。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*最大.*"
                        },
                        "properties": [
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "dash": [5, 10],
                                    "fill": "dash"
                                }
                            },
                            {
                                "id": "custom.fillOpacity",
                                "value": 0
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 7
            },
            "id": 202,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(lettuce_command_firstresponse_seconds_bucket{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (le, command)) * 1000",
                    "legendFormat": "P50 - {{command}}",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(lettuce_command_firstresponse_seconds_bucket{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (le, command)) * 1000",
                    "legendFormat": "P95 - {{command}}",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(lettuce_command_firstresponse_seconds_bucket{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (le, command)) * 1000",
                    "legendFormat": "P99 - {{command}}",
                    "refId": "C"
                },
                {
                    "expr": "lettuce_command_firstresponse_seconds_max{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"} * 1000",
                    "legendFormat": "最大值 - {{command}}",
                    "refId": "D"
                }
            ],
            "title": "首次响应延迟分布",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 15
            },
            "id": 300,
            "panels": [],
            "title": "命令性能分析",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "各类型 Redis 命令的执行吞吐量（ops）。用于分析命令使用模式和识别热点命令。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ops"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            },
            "id": 301,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "sum(rate(lettuce_command_completion_seconds_count{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[1m])) by (command)",
                    "legendFormat": "{{command}}",
                    "refId": "A"
                }
            ],
            "title": "命令吞吐量（按命令类型）",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "各类型 Redis 命令的平均完成延迟。用于对比不同命令的性能表现和识别慢命令。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 16
            },
            "id": 302,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "(sum(rate(lettuce_command_completion_seconds_sum{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (command) / clamp_min(sum(rate(lettuce_command_completion_seconds_count{instance=~\"$instance\", job=~\"$job\", command=~\"$command\"}[5m])) by (command), 0.001)) * 1000",
                    "legendFormat": "{{command}}",
                    "refId": "A"
