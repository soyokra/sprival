{
  "test_name": "Test Feign Circuit Breaker Success",
  "description": "测试 Feign 熔断器成功场景 - 熔断器关闭后正常工作",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 0,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 1,
    "duration": 30
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "INFO",
    "log_to_file": true,
    "log_to_console": true,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/feign/circuit-breaker",
    "method": "GET",
    "params": {
      "shouldFail": "false",
      "delay": "0"
    }
  }
}

