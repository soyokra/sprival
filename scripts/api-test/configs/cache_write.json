{
  "test_name": "Test Post Cache Write Performance",
  "description": "测试缓存写入接口性能 - 恒定负载",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 30,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/cache/write",
    "method": "POST",
    "body_template": {
      "key": "${mock:string:10:50:alphanumeric}",
      "value": "${mock:string:50:500:alphanumeric}",
      "cacheName": "post",
      "ttl": "${mock:int:60000:600000:}"
    }
  }
}

