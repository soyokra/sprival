{
  "test_name": "Ramp Up Load Test",
  "description": "渐进式压测示例",

  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "ramp_up",
    "target_threads": 100,
    "ramp_duration": 60,
    "hold_duration": 120,
    "initial_threads": 1,
    "ramp_steps": 10
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "INFO",
    "log_to_file": true,
    "log_to_console": true,
    "log_dir": "logs"
  },

  "api": {
    "endpoint": "/mysql/create",
    "method": "POST",
    "body_template": {
      "title": "${mock:string:10:200:alphanumeric}",
      "slug": "${mock:string:10:200:alphanumeric}",
      "content": "${mock:string:100:5000:alphanumeric}",
      "excerpt": "${mock:string:50:500:alphanumeric}",
      "status": "${mock:choice:draft:published:archived}",
      "authorId": "${mock:int:1:100}",
      "categoryId": "${mock:int:1:20}"
    }
  }
}

