{
  "test_name": "Test Post Mixed Operations",
  "description": "测试文章接口混合操作 - 包含查询、创建、更新等操作",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 30,
    "duration": 120
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/post/get-list",
    "method": "GET",
    "params": {
      "pageNo": "${mock:int:1:10}",
      "pageSize": 20,
      "status": "${mock:choice:published::}"
    }
  },
  
  "mixed_operations": [
    {
      "weight": 50,
      "endpoint": "/post/get-list",
      "method": "GET",
      "params": {
        "pageNo": "${mock:int:1:10}",
        "pageSize": 20
      }
    },
    {
      "weight": 20,
      "endpoint": "/post/get-by-id",
      "method": "GET",
      "params": {
        "id": "${mock:int:1:1000}"
      }
    },
    {
      "weight": 15,
      "endpoint": "/post/create",
      "method": "POST",
      "body_template": {
        "title": "${mock:string:10:200:alphanumeric}",
        "slug": "${mock:string:10:200:alphanumeric}",
        "content": "${mock:string:100:5000:alphanumeric}",
        "excerpt": "${mock:string:50:500:alphanumeric}",
        "status": "draft",
        "authorId": "${mock:int:1:100}",
        "categoryId": "${mock:int:1:20}"
      }
    },
    {
      "weight": 10,
      "endpoint": "/post/update",
      "method": "POST",
      "body_template": {
        "id": "${mock:int:1:1000}",
        "title": "${mock:string:10:200:alphanumeric:}",
        "status": "${mock:choice:draft:published:archived:}"
      }
    },
    {
      "weight": 5,
      "endpoint": "/post/view-count",
      "method": "POST",
      "body_template": {
        "id": "${mock:int:1:1000}"
      }
    }
  ]
}

