{
  "test_name": "Test Post Cache Evict Performance",
  "description": "测试缓存清除接口性能（单个）",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 20,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/post-cache/evict",
    "method": "POST",
    "body_template": {
      "key": "${mock:string:10:50:alphanumeric}",
      "cacheName": "post"
    }
  }
}

