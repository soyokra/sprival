{
    "test_name": "Feign Comprehensive Load Test",
    "description": "Feign 综合负载测试 - 高并发采集完整指标数据",
    
    "http": {
        "base_url": "http://127.0.0.1:8338",
        "timeout": 30,
        "max_retries": 0,
        "verify_ssl": true,
        "default_headers": {
            "Content-Type": "application/json"
        }
    },
    
    "scenario": {
        "type": "constant",
        "threads": 50,
        "duration": 300
    },
    
    "report": {
        "formats": ["console", "json", "html"],
        "report_dir": "reports",
        "auto_save": true
    },
    
    "log": {
        "level": "INFO",
        "log_to_file": true,
        "log_to_console": true,
        "log_dir": "logs"
    },
    
    "api": {
        "endpoint": "/api/client/test/combined",
        "method": "GET",
        "params": {
            "shouldFail": "true"
        }
    }
}

