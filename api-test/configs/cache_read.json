{
  "test_name": "Test Post Cache Read Performance",
  "description": "测试缓存读取接口性能 - 测试缓存命中/未命中",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 50,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/cache/read",
    "method": "GET",
    "params": {
      "key": "${mock:string:10:50:alphanumeric}",
      "cacheName": "post"
    }
  }
}

