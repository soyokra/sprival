{
  "test_name": "Spike Test",
  "description": "峰值冲击测试示例",
  
  "http": {
    "base_url": "https://api.example.com",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": true
  },
  
  "scenario": {
    "type": "spike",
    "spike_threads": 200,
    "spike_duration": 10,
    "base_threads": 10,
    "warmup_duration": 30
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "INFO",
    "log_to_file": true,
    "log_to_console": true,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/api/v1/products",
    "method": "GET",
    "params": {
      "page": "${mock:int:1:100}",
      "size": 20
    }
  }
}

