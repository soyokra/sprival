{
  "test_name": "Test Post RabbitMQ Send Ramp Up Load",
  "description": "测试RabbitMQ消息发送接口渐进式压测 - 寻找性能拐点",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "ramp_up",
    "initial_threads": 1,
    "target_threads": 100,
    "ramp_duration": 60,
    "hold_duration": 120
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/rabbit/send",
    "method": "POST",
    "body_template": {
      "queue": "post.test.queue",
      "message": {
        "id": "${mock:int:1:10000}",
        "title": "${mock:string:10:200:alphanumeric}",
        "content": "${mock:string:100:1000:alphanumeric}",
        "timestamp": "${mock:timestamp}"
      }
    }
  }
}

