{
  "test_name": "Test Feign Retry",
  "description": "测试 Feign 重试功能 - 前 N 次失败，第 N+1 次成功",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 0,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 1,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "INFO",
    "log_to_file": true,
    "log_to_console": true,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/feign/retry",
    "method": "GET",
    "params": {
      "shouldFail": "true",
      "failTimes": "2"
    }
  }
}

