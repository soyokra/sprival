{
  "test_name": "Test Order Query By PK",
  "description": "测试订单主键查询性能 - 高并发",
  
  "http": {
    "base_url": "http://127.0.0.1:8338",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": true,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 50,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/api/test/order/get/${mock:int:1:100000}",
    "method": "GET"
  }
}

