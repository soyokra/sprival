{
  "test_name": "Test Post Cache Mixed Operations",
  "description": "测试缓存接口混合操作 - 包含读取、写入、清除等操作",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 30,
    "duration": 120
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/post-cache/read",
    "method": "GET",
    "params": {
      "key": "${mock:string:10:50:alphanumeric}",
      "cacheName": "post"
    }
  },
  
  "mixed_operations": [
    {
      "weight": 50,
      "endpoint": "/post-cache/read",
      "method": "GET",
      "params": {
        "key": "${mock:string:10:50:alphanumeric}",
        "cacheName": "post"
      }
    },
    {
      "weight": 30,
      "endpoint": "/post-cache/write",
      "method": "POST",
      "body_template": {
        "key": "${mock:string:10:50:alphanumeric}",
        "value": "${mock:string:50:500:alphanumeric}",
        "cacheName": "post"
      }
    },
    {
      "weight": 15,
      "endpoint": "/post-cache/evict",
      "method": "POST",
      "body_template": {
        "key": "${mock:string:10:50:alphanumeric}",
        "cacheName": "post"
      }
    },
    {
      "weight": 5,
      "endpoint": "/post-cache/redis-command",
      "method": "POST",
      "body_template": {
        "command": "${mock:choice:GET:SET}",
        "key": "${mock:string:10:50:alphanumeric}",
        "value": "${mock:string:50:500:alphanumeric:}",
        "count": 100
      }
    }
  ]
}

