{
    "test_name": "Feign Timeout Test",
    "description": "测试 Feign 超时降级机制 - 6秒延迟触发超时",
    
    "http": {
        "base_url": "http://127.0.0.1:8338",
        "timeout": 30,
        "max_retries": 0,
        "verify_ssl": true,
        "default_headers": {
            "Content-Type": "application/json"
        }
    },
    
    "scenario": {
        "type": "constant",
        "threads": 5,
        "duration": 60
    },
    
    "report": {
        "formats": ["console", "json", "html"],
        "report_dir": "reports",
        "auto_save": true
    },
    
    "log": {
        "level": "INFO",
        "log_to_file": true,
        "log_to_console": true,
        "log_dir": "logs"
    },
    
    "api": {
        "endpoint": "/api/client/test/timeout",
        "method": "GET",
        "params": {
            "delay": "6000"
        }
    }
}

