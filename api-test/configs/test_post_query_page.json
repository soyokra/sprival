{
  "test_name": "Test Post Page Query Performance",
  "description": "测试文章分页查询接口性能",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 30,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/post/get-list",
    "method": "GET",
    "params": {
      "pageNo": "${mock:int:1:100}",
      "pageSize": "${mock:choice:10:20:50}",
      "status": "${mock:choice:draft:published:archived:}",
      "categoryId": "${mock:int:1:20:}",
      "authorId": "${mock:int:1:100:}",
      "keyword": "${mock:string:3:10:alphanumeric:}"
    }
  }
}

