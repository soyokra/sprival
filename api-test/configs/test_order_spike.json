{
  "test_name": "Test Order Spike Test",
  "description": "测试订单峰值冲击 - 突发流量测试",
  
  "http": {
    "base_url": "http://127.0.0.1:8338",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": true,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "spike",
    "spike_threads": 200,
    "spike_duration": 15,
    "base_threads": 10,
    "warmup_duration": 30
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/api/test/order/page",
    "method": "GET",
    "params": {
      "userId": "${mock:int:1:10000}",
      "pageNo": 1,
      "pageSize": 20
    }
  }
}

