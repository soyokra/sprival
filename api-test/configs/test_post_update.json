{
  "test_name": "Test Post Update Performance",
  "description": "测试更新文章接口性能",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 20,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/post/update",
    "method": "POST",
    "body_template": {
      "id": "${mock:int:1:1000}",
      "title": "${mock:string:10:200:alphanumeric:}",
      "slug": "${mock:string:10:200:alphanumeric:}",
      "content": "${mock:string:100:5000:alphanumeric:}",
      "excerpt": "${mock:string:50:500:alphanumeric:}",
      "status": "${mock:choice:draft:published:archived:}",
      "categoryId": "${mock:int:1:20:}"
    }
  }
}

