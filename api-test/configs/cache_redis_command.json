{
  "test_name": "Test Post Cache Redis Command Performance",
  "description": "测试Redis直接操作接口性能 - 测试GET/SET等命令",
  
  "http": {
    "base_url": "${sprival.url}",
    "timeout": 120,
    "max_retries": 3,
    "verify_ssl": false,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "constant",
    "threads": 20,
    "duration": 60
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/cache/redis-command",
    "method": "POST",
    "body_template": {
      "command": "${mock:choice:GET:SET:HGET:HSET:ZADD:DEL}",
      "key": "${mock:string:10:50:alphanumeric}",
      "value": "${mock:string:50:500:alphanumeric:}",
      "count": "${mock:int:100:1000}"
    }
  }
}

