{
  "test_name": "Test Order Ramp Up Load Test",
  "description": "测试订单渐进式压测 - 寻找性能拐点",
  
  "http": {
    "base_url": "http://127.0.0.1:8338",
    "timeout": 30,
    "max_retries": 3,
    "verify_ssl": true,
    "default_headers": {
      "Content-Type": "application/json"
    }
  },
  
  "scenario": {
    "type": "ramp_up",
    "target_threads": 100,
    "ramp_duration": 120,
    "hold_duration": 180,
    "initial_threads": 10,
    "ramp_steps": 10
  },
  
  "report": {
    "formats": ["console", "json", "html"],
    "report_dir": "reports",
    "auto_save": true
  },
  
  "log": {
    "level": "WARNING",
    "log_to_file": true,
    "log_to_console": false,
    "log_dir": "logs"
  },
  
  "api": {
    "endpoint": "/api/test/order/insert",
    "method": "POST",
    "body_template": {
      "orderNo": "${mock:string:28:alphanumeric}",
      "userId": "${mock:int:1:10000}",
      "productId": "${mock:int:1:1000}",
      "productName": "${mock:choice:iPhone 15 Pro:MacBook Pro:iPad Air:Samsung Galaxy S24}",
      "quantity": "${mock:int:1:10}",
      "unitPrice": "${mock:float:100.0:9999.0:2}",
      "totalAmount": "${mock:float:100.0:99999.0:2}",
      "status": 0,
      "paymentMethod": "${mock:choice:支付宝:微信支付}",
      "shippingAddress": "${mock:choice:北京市朝阳区建国门外大街1号:上海市浦东新区世纪大道88号}",
      "remark": "${mock:string:50:alphanumeric}"
    }
  }
}

