                        "properties": [
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "dash": [5, 10],
                                    "fill": "dash"
                                }
                            },
                            {
                                "id": "custom.fillOpacity",
                                "value": 0
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 39
            },
            "id": 602,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "(rate(http_server_requests_seconds_sum{instance=~\"$instance\", job=~\"$job\"}[5m]) / clamp_min(rate(http_server_requests_seconds_count{instance=~\"$instance\", job=~\"$job\"}[5m]), 0.001)) * 1000",
                    "legendFormat": "HTTP 请求平均延迟",
                    "refId": "A"
