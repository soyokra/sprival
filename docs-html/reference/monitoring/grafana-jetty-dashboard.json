        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "HTTP 请求 QPS，按状态码分组。用于监控服务流量和错误率。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "reqps"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*4xx.*"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "orange",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*5xx.*"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "red",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 39
            },
            "id": 601,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\", job=~\"$job\"}[1m]))",
                    "legendFormat": "总 QPS",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\", job=~\"$job\", status=~\"2..\"}[1m]))",
                    "legendFormat": "2xx 成功请求",
                    "refId": "B"
                },
                {
                    "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\", job=~\"$job\", status=~\"4..\"}[1m]))",
                    "legendFormat": "4xx 客户端错误",
                    "refId": "C"
                },
                {
                    "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\", job=~\"$job\", status=~\"5..\"}[1m]))",
                    "legendFormat": "5xx 服务端错误",
                    "refId": "D"
                }
            ],
            "title": "请求 QPS (按状态码)",
            "type": "timeseries"
        },
