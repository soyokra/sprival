{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "datasource",
                    "uid": "grafana"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 100,
            "panels": [],
            "title": "服务器健康状态总览",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "线程池利用率：活动线程数 / 最大线程数。\n- 绿色 (<70%)：资源充足\n- 黄色 (70-90%)：负载较高\n- 红色 (>90%)：资源紧张，可能需要扩容",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 70
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 0,
                "y": 1
            },
            "id": 101,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "(jetty_threads_busy{instance=~\"$instance\", job=~\"$job\"} / clamp_min(jetty_threads_config_max{instance=~\"$instance\", job=~\"$job\"}, 1)) * 100",
                    "refId": "A"
                }
            ],
            "title": "服务器健康度",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "当前正在处理请求的活动线程数。趋势线帮助观察服务负载变化。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 5,
                "y": 1
            },
            "id": 102,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "jetty_threads_busy{instance=~\"$instance\", job=~\"$job\"}",
                    "refId": "A"
                }
            ],
            "title": "当前活动线程数",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "队列中等待执行的任务数。\n- 绿色 (0)：无积压\n- 红色 (>0)：有任务排队，线程池可能不足",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 10,
                "y": 1
            },
            "id": 103,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "jetty_threads_jobs{instance=~\"$instance\", job=~\"$job\"}",
                    "refId": "A"
                }
            ],
            "title": "等待任务数",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "当前活动的 TCP 连接数。异常增长需要排查是否存在连接泄露。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 14,
                "y": 1
            },
            "id": 104,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "jetty_connections_current_connections{instance=~\"$instance\", job=~\"$job\"}",
                    "refId": "A"
                }
            ],
            "title": "当前连接数",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "平均 HTTP 请求响应延迟（5分钟窗口）。\n- 绿色 (<100ms)：性能优秀\n- 黄色 (100-500ms)：性能一般\n- 红色 (>500ms)：性能较差，需要优化",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 100
                            },
                            {
                                "color": "red",
                                "value": 500
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 5,
                "x": 19,
                "y": 1
            },
            "id": 105,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "(rate(http_server_requests_seconds_sum{instance=~\"$instance\", job=~\"$job\"}[5m]) / clamp_min(rate(http_server_requests_seconds_count{instance=~\"$instance\", job=~\"$job\"}[5m]), 0.001)) * 1000",
                    "refId": "A"
                }
            ],
            "title": "平均响应延迟",
            "type": "stat"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
