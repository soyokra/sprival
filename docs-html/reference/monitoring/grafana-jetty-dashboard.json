                    "refId": "B"
                },
                {
                    "expr": "(rate(jetty_connections_request_seconds_sum{instance=~\"$instance\", job=~\"$job\"}[5m]) / clamp_min(rate(jetty_connections_request_seconds_count{instance=~\"$instance\", job=~\"$job\"}[5m]), 0.001)) * 1000",
                    "legendFormat": "连接级别平均延迟",
                    "refId": "C"
                },
                {
                    "expr": "jetty_connections_request_seconds_max{instance=~\"$instance\", job=~\"$job\"} * 1000",
                    "legendFormat": "连接级别最大延迟",
                    "refId": "D"
                }
            ],
