            },
            "id": 500,
            "panels": [],
            "title": "流量监控",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "网络流量统计：入站/出站字节速率和平均请求/响应大小。用于监控带宽使用和评估压缩效果。",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "gradientMode": "none",
                        "hideFrom": {
                            "tooltip": false,
                            "viz": false,
                            "legend": false
                        },
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "Bps"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*平均.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "bytes"
                            },
                            {
                                "id": "custom.axisPlacement",
                                "value": "right"
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 30
            },
            "id": 501,
            "options": {
                "legend": {
                    "calcs": [
                        "last",
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "rate(jetty_connections_bytes_in_bytes_sum{instance=~\"$instance\", job=~\"$job\"}[1m])",
                    "legendFormat": "入站字节速率 (B/s)",
                    "refId": "A"
                },
                {
                    "expr": "rate(jetty_connections_bytes_out_bytes_sum{instance=~\"$instance\", job=~\"$job\"}[1m])",
                    "legendFormat": "出站字节速率 (B/s)",
                    "refId": "B"
                },
                {
                    "expr": "rate(jetty_connections_bytes_in_bytes_sum{instance=~\"$instance\", job=~\"$job\"}[5m]) / clamp_min(rate(jetty_connections_bytes_in_bytes_count{instance=~\"$instance\", job=~\"$job\"}[5m]), 0.001)",
                    "legendFormat": "平均请求大小 (bytes)",
                    "refId": "C"
                },
                {
                    "expr": "rate(jetty_connections_bytes_out_bytes_sum{instance=~\"$instance\", job=~\"$job\"}[5m]) / clamp_min(rate(jetty_connections_bytes_out_bytes_count{instance=~\"$instance\", job=~\"$job\"}[5m]), 0.001)",
                    "legendFormat": "平均响应大小 (bytes)",
                    "refId": "D"
                }
            ],
            "title": "连接字节数统计",
            "type": "timeseries"
        },
