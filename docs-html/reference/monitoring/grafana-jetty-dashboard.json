                },
                {
                    "expr": "rate(jetty_connections_messages_out_messages_total{instance=~\"$instance\", job=~\"$job\"}[1m])",
                    "legendFormat": "出站消息速率 (messages/s)",
                    "refId": "B"
                }
            ],
            "title": "连接消息统计",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
