<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Kafka日志输出 -->
    <appender name="KAFKA" class="com.soyokra.sprival.support.logging.KafkaAppender">
        <!-- Kafka服务器配置 -->
        <bootstrapServers>${sprival.logging.kafka.bootstrap-servers:localhost:9092}</bootstrapServers>
        <topic>${sprival.logging.kafka.topic:application-logs}</topic>
        <clientId>${sprival.logging.kafka.client-id:kafka-appender}</clientId>
        
        <!-- 生产者配置 -->
        <acks>${sprival.logging.kafka.acks:1}</acks>
        <retries>${sprival.logging.kafka.retries:3}</retries>
        <batchSize>${sprival.logging.kafka.batch-size:16384}</batchSize>
        <lingerMs>${sprival.logging.kafka.linger-ms:1}</lingerMs>
        <bufferMemory>${sprival.logging.kafka.buffer-memory:33554432}</bufferMemory>
        <compressionType>${sprival.logging.kafka.compression-type:none}</compressionType>
        <enableIdempotence>${sprival.logging.kafka.enable-idempotence:false}</enableIdempotence>
        
        <!-- 超时配置 -->
        <requestTimeoutMs>${sprival.logging.kafka.request-timeout-ms:30000}</requestTimeoutMs>
        <deliveryTimeoutMs>${sprival.logging.kafka.delivery-timeout-ms:120000}</deliveryTimeoutMs>
        <maxBlockMs>${sprival.logging.kafka.max-block-ms:60000}</maxBlockMs>
        
        <!-- 序列化器配置 -->
        <keySerializer>${sprival.logging.kafka.key-serializer:org.apache.kafka.common.serialization.StringSerializer}</keySerializer>
        <valueSerializer>${sprival.logging.kafka.value-serializer:org.apache.kafka.common.serialization.StringSerializer}</valueSerializer>
    </appender>

    <!-- 异步Kafka日志输出（推荐用于生产环境） -->
    <appender name="ASYNC_KAFKA" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="KAFKA"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <!-- 根据配置决定是否启用Kafka日志 -->
        <if condition='property("sprival.logging.kafka.enabled").equals("true")'>
            <then>
                <appender-ref ref="ASYNC_KAFKA" />
            </then>
        </if>
    </root>

    <!-- 应用日志级别 -->
    <logger name="com.soyokra.sprival" level="DEBUG" />
    
    <!-- Spring框架日志级别 -->
    <logger name="org.springframework" level="INFO" />
    
    <!-- 数据库日志级别 -->
    <logger name="org.springframework.jdbc" level="DEBUG" />
    <logger name="org.springframework.transaction" level="DEBUG" />
    
    <!-- Redis日志级别 -->
    <logger name="org.springframework.data.redis" level="DEBUG" />
    
    <!-- MongoDB日志级别 -->
    <logger name="org.springframework.data.mongodb" level="DEBUG" />
    
    <!-- Kafka日志级别 -->
    <logger name="org.apache.kafka" level="WARN" />
    <logger name="org.springframework.kafka" level="INFO" />
    
    <!-- 第三方库日志级别 -->
    <logger name="org.h2" level="WARN" />
    <logger name="redis.embedded" level="WARN" />
    <logger name="de.flapdoodle.embed" level="WARN" />
</configuration>
