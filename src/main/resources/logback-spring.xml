<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="true">
    <springProperty scope="context" name="kafkaBootstrapServers" source="sprival.logging.kafka.bootstrap-servers" defaultValue="localhost:9092"/>
    <springProperty scope="context" name="kafkaTopic" source="sprival.logging.kafka.topic" defaultValue="application-logs"/>
    <springProperty scope="context" name="kafkaClientId" source="sprival.logging.kafka.client-id" defaultValue="sprival-log-app"/>
    <springProperty scope="context" name="kafkaAcks" source="sprival.logging.kafka.acks" defaultValue="all"/>
    <springProperty scope="context" name="kafkaRetries" source="sprival.logging.kafka.retries" defaultValue="3"/>
    <springProperty scope="context" name="kafkaBatchSize" source="sprival.logging.kafka.batch-size" defaultValue="16384"/>
    <springProperty scope="context" name="kafkaLingerMs" source="sprival.logging.kafka.linger-ms" defaultValue="5"/>
    <springProperty scope="context" name="kafkaBufferMemory" source="sprival.logging.kafka.buffer-memory" defaultValue="33554432"/>
    <springProperty scope="context" name="kafkaCompressionType" source="sprival.logging.kafka.compression-type" defaultValue="lz4"/>
    <springProperty scope="context" name="kafkaEnableIdempotence" source="sprival.logging.kafka.enable-idempotence" defaultValue="true"/>
    <springProperty scope="context" name="kafkaRequestTimeoutMs" source="sprival.logging.kafka.request-timeout-ms" defaultValue="30000"/>
    <springProperty scope="context" name="kafkaDeliveryTimeoutMs" source="sprival.logging.kafka.delivery-timeout-ms" defaultValue="120000"/>
    <springProperty scope="context" name="kafkaMaxBlockMs" source="sprival.logging.kafka.max-block-ms" defaultValue="60000"/>
    
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 按日期和大小滚动：logs/application-2025-10-21.0.log -->
            <fileNamePattern>logs/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单个文件最大100MB -->
            <maxFileSize>100MB</maxFileSize>
            <!-- 保留30天 -->
            <maxHistory>30</maxHistory>
            <!-- 总大小限制5GB -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Kafka日志输出 -->
    <appender name="KAFKA" class="com.soyokra.sprival.support.logging.KafkaAppender">
        <!-- Kafka服务器配置 -->
        <bootstrapServers>${kafkaBootstrapServers}</bootstrapServers>
        <topic>${kafkaTopic}</topic>
        <clientId>${kafkaClientId}</clientId>
        
        <!-- 生产者配置 -->
        <acks>${kafkaAcks}</acks>
        <retries>${kafkaRetries}</retries>
        <batchSize>${kafkaBatchSize}</batchSize>
        <lingerMs>${kafkaLingerMs}</lingerMs>
        <bufferMemory>${kafkaBufferMemory}</bufferMemory>
        <compressionType>${kafkaCompressionType}</compressionType>
        <enableIdempotence>${kafkaEnableIdempotence}</enableIdempotence>
        
        <!-- 超时配置 -->
        <requestTimeoutMs>${kafkaRequestTimeoutMs}</requestTimeoutMs>
        <deliveryTimeoutMs>${kafkaDeliveryTimeoutMs}</deliveryTimeoutMs>
        <maxBlockMs>${kafkaMaxBlockMs}</maxBlockMs>
        
        <!-- 序列化器配置 -->
        <keySerializer>org.apache.kafka.common.serialization.StringSerializer</keySerializer>
        <valueSerializer>org.apache.kafka.common.serialization.StringSerializer</valueSerializer>
    </appender>

    <!-- Kafka异步包装，避免阻塞 -->
    <appender name="ASYNC_KAFKA" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="KAFKA" />
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ASYNC_KAFKA" />
    </root>

    <!-- 应用日志级别 -->
    <logger name="com.soyokra.sprival" level="DEBUG" />
    
    <!-- Spring框架日志级别 -->
    <logger name="org.springframework" level="INFO" />
    
    <!-- 数据库日志级别 -->
    <logger name="org.springframework.jdbc" level="DEBUG" />
    <logger name="org.springframework.transaction" level="DEBUG" />
    
    <!-- Redis日志级别 -->
    <logger name="org.springframework.data.redis" level="DEBUG" />
    
    <!-- MongoDB日志级别 -->
    <logger name="org.springframework.data.mongodb" level="DEBUG" />
    
    <!-- Kafka日志级别 -->
    <logger name="org.apache.kafka" level="WARN">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
    <logger name="org.apache.kafka.clients" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
    <logger name="org.springframework.kafka" level="INFO" />
    
    <!-- 第三方库日志级别 -->
    <logger name="org.h2" level="WARN" />
    <logger name="redis.embedded" level="WARN" />
    <logger name="de.flapdoodle.embed" level="WARN" />
    
    <!-- P6Spy SQL日志配置 -->
    <appender name="P6SPY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/spy.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/spy-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- P6Spy logger：输出 SQL 执行日志 -->
    <logger name="p6spy" level="INFO" additivity="false">
        <appender-ref ref="P6SPY_FILE" />
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="p6spy.log" level="INFO" additivity="false">
        <appender-ref ref="P6SPY_FILE" />
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="p6spy.perf" level="INFO" additivity="false">
        <appender-ref ref="P6SPY_FILE" />
        <appender-ref ref="CONSOLE" />
    </logger>
</configuration>

